  "notes": [
    {
      "text": "J1, J2 and J3 each carry 1 GND, 2 3V3, 3 SDA, 4 SCL to the J1 of one bank sheet: J1 to bank A (sheet 2), J2 to bank B (sheet 3), J3 to bank C (sheet 4).",
      "near": "To the expander banks"
    },
    { "text": "DS1, DS2 and SD1 share one SPI bus; each has its own CS pin.", "near": "OLED and SD card" }
  ],
