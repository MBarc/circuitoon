{
  "format": "circuitoon-netlist/1",
  "title": "Spirit Typewriter 2 of 4: expander bank A, balls 1 to 14",
  "parts": [
    { "ref": "J1", "module": "jst-xh-4" },
    { "ref": "U2", "module": "mcp23017-cjmcu-2317" },
    { "ref": "BB1", "module": "power-rail-strip" },
    { "ref": "BB2", "module": "breadboard-half" }
  ],
  "nets": [
    { "name": "3V3", "pins": ["J1.2", "U2.VCC", "U2.RESET", "BB1.+"] },
    { "name": "GND", "pins": ["J1.1", "U2.GND", "U2.A0", "U2.A1", "U2.A2", "BB1.-"] },
    { "name": "SDA", "pins": ["J1.3", "U2.SDA"] },
    { "name": "SCL", "pins": ["J1.4", "U2.SCL"] }
  ],
  "repeat": {
    "name": "ballA",
    "count": 14,
    "refs": "A{copy}{ref}",
    "template": {
      "parts": [{ "ref": "SA", "module": "tilt-switch-sw520d" }, { "ref": "SB", "module": "tilt-switch-sw520d" }],
      "nets": [{ "name": "CH", "pins": ["SA.1", "SB.1"] }, { "name": "GND", "pins": ["SA.2", "SB.2"] }],
      "ports": ["CH", "GND"]
    },
    "bindings": [
      { "CH": "U2.GPA0" },
      { "CH": "U2.GPA1" },
      { "CH": "U2.GPA2" },
      { "CH": "U2.GPA3" },
      { "CH": "U2.GPA4" },
      { "CH": "U2.GPA5" },
      { "CH": "U2.GPA6" },
      { "CH": "U2.GPB0" },
      { "CH": "U2.GPB1" },
      { "CH": "U2.GPB2" },
      { "CH": "U2.GPB3" },
      { "CH": "U2.GPB4" },
      { "CH": "U2.GPB5" },
      { "CH": "U2.GPB6" }
    ],
    "shared": { "GND": "GND" }
  },
  "groups": [{ "name": "Expander A (0x20)", "parts": ["J1", "U2"] }],
  "notes": [
    {
      "text": "J1 comes from J1 on sheet 1: 1 GND, 2 3V3, 3 SDA, 4 SCL. A0, A1 and A2 to GND give I2C address 0x20; RESET is tied to 3V3. The I2C pull-ups are on sheet 1 (see its J1 note), not here.",
      "near": "Expander A (0x20)"
    },
    {
      "text": "ballA 1 to 14 are balls 1 to 14. Each ball's two tilt switches share one input. GPA7 and GPB7 are output only on the MCP23017, so a bank takes 14 balls. Enable the MCP23017 pull-ups in firmware; a closed switch reads low.",
      "near": "U2"
    }
  ],
  "wires": { "color": { "3V3": "red", "GND": "black", "SDA": "blue", "SCL": "yellow" }, "ends": "dupont-female" }
}
