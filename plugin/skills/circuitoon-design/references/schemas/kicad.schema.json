          "ref": {
            "type": "string"
          },
          "module": {
            "type": "string"
          }
        }
      }
    },
    "placeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "module"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "module": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
