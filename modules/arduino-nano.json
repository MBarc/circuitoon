            "vf": {
              "value": 0.31,
              "unit": "V",
              "source": "https://www.vishay.com/docs/88915/ss1p3l.pdf",
              "provenance": "estimate",
              "note": "D1 on the Nano V3.3 schematic is an SS1P3L (Vishay), VUSB anode to +5V cathode (\"+5V AUTO SELECTOR\"). Read from Fig. 3 Typical Instantaneous Forward Characteristics (p. 3), 25 C curve at about 0.1 A: about 0.31 V. The only tabulated value is the maximum, 0.45 V at IF = 1.0 A, 25 C (Electrical Characteristics, p. 2)."
            },
            "reverse": "blocks"
