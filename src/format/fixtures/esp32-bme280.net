      (fields (field (name "Footprint") "Connector_PinSocket_2.54mm:PinSocket_1x19_P2.54mm_Vertical") (field (name "Description") "ESP32 DevKitC V4 (38 pin), right header, pin 1 GND 2 (Circuitoon part esp32-devkitc-v4)"))
