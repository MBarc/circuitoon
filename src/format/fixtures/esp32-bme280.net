        (pin (num "8") (name "Pin_8") (type "passive"))
        (pin (num "9") (name "Pin_9") (type "passive"))
        (pin (num "10") (name "Pin_10") (type "passive"))
        (pin (num "11") (name "Pin_11") (type "passive"))
        (pin (num "12") (name "Pin_12") (type "passive"))
        (pin (num "13") (name "Pin_13") (type "passive"))
        (pin (num "14") (name "Pin_14") (type "passive"))
        (pin (num "15") (name "Pin_15") (type "passive"))
        (pin (num "16") (name "Pin_16") (type "passive"))
        (pin (num "17") (name "Pin_17") (type "passive"))
        (pin (num "18") (name "Pin_18") (type "passive"))
        (pin (num "19") (name "Pin_19") (type "passive"))
      ))
  )
  (nets
    (net (code "1") (name "3V3")
      (node (ref "U1A") (pin "1") (pinfunction "3V3") (pintype "power_out"))
      (node (ref "U2") (pin "1") (pinfunction "VIN") (pintype "power_in")))
    (net (code "2") (name "GND")
      (node (ref "U1A") (pin "14") (pinfunction "GND") (pintype "power_in"))
      (node (ref "U1B") (pin "1") (pinfunction "GND 2") (pintype "power_in"))
      (node (ref "U1B") (pin "7") (pinfunction "GND 3") (pintype "power_in"))
      (node (ref "U2") (pin "2") (pinfunction "GND") (pintype "power_in")))
    (net (code "3") (name "SCL")
      (node (ref "U1B") (pin "3") (pinfunction "IO22") (pintype "bidirectional"))
      (node (ref "U2") (pin "3") (pinfunction "SCL") (pintype "input")))
    (net (code "4") (name "SDA")
      (node (ref "U1B") (pin "6") (pinfunction "IO21") (pintype "bidirectional"))
      (node (ref "U2") (pin "4") (pinfunction "SDA") (pintype "bidirectional")))
  )
)
