      (libsource (lib "Circuitoon") (part "bme280-module-4pin") (description "BME280 sensor module (4-pin, I2C: VIN GND SCL SDA) (Circuitoon part bme280-module-4pin)"))
      (fields (field (name "Footprint") "Connector_PinSocket_2.54mm:PinSocket_1x04_P2.54mm_Vertical") (field (name "Description") "BME280 sensor module (4-pin, I2C: VIN GND SCL SDA) (Circuitoon part bme280-module-4pin)"))
